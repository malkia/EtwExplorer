<Window x:Class="EtwExplorer.Views.EtwProviderSelectionDialog"
		xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:view="using:EtwExplorer.Views"
		Title="Select ETW Provider" Width="760" Height="540" MinWidth="600" MinHeight="400">
  <Grid RowDefinitions="Auto,*,Auto" Margin="8">
	<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
	  <view:SearchBox TextBoxWidth="220" />
	  <CheckBox Content="Likely Existing Manifests" IsChecked="{Binding IsLikely}" VerticalAlignment="Center" />
	  <CheckBox Content="Close Current Manifest" IsChecked="{Binding CloseCurrentManifest}" VerticalAlignment="Center" />
	</StackPanel>
	<DataGrid Grid.Row="1" ItemsSource="{Binding ProviderView}" AutoGenerateColumns="False" IsReadOnly="True" SelectedItem="{Binding SelectedProvider}">
	  <DataGrid.Columns>
		<DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
		<DataGridTextColumn Header="GUID" Binding="{Binding Guid}" Width="3*" />
	  </DataGrid.Columns>
	</DataGrid>
	<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,8,0,0">
	  <Button Content="OK" Width="90" Command="{Binding OKCommand}" IsDefault="True" />
	  <Button Content="Cancel" Width="90" Command="{Binding CancelCommand}" IsCancel="True" />
	</StackPanel>
  </Grid>
</Window>
