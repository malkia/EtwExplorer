<UserControl x:Class="EtwExplorer.Views.MainView"
			 xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
	<Menu Grid.Row="0">
	  <MenuItem Header="_File">
		<MenuItem Header="Open Registered ETW Provider Manifest..." Command="{Binding OpenRegisteredCommand}" />
		<MenuItem Header="Open XML ETW Manifest..." Command="{Binding OpenXmlCommand}" />
		<MenuItem Header="Save XML Manifest..." Command="{Binding SaveXmlCommand}" />
		<MenuItem Header="Close" Command="{Binding CloseCommand}" />
		<Separator />
		<MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
	  </MenuItem>
	</Menu>
	<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4">
	  <Button Command="{Binding OpenRegisteredCommand}" Content="Open Provider..." />
	</StackPanel>
	<TabControl Grid.Row="2" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
	  <TabControl.ItemTemplate>
		<DataTemplate>
		  <TextBlock Text="{Binding Header}" FontSize="15" />
		</DataTemplate>
	  </TabControl.ItemTemplate>
	</TabControl>
	<StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" Margin="6">
	  <TextBlock Text="{Binding FileName, TargetNullValue='(No file)'}" />
	  <TextBlock Text="{Binding ProviderName}" />
	</StackPanel>
  </Grid>
</UserControl>
