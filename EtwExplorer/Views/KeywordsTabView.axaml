<UserControl x:Class="EtwExplorer.Views.KeywordsTabView"
			 xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DataGrid ItemsSource="{Binding Keywords}" AutoGenerateColumns="False" IsReadOnly="True">
	<DataGrid.Columns>
	  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
	  <DataGridTextColumn Header="Value" Binding="{Binding Mask}" Width="*" />
	  <DataGridTextColumn Header="Description" Binding="{Binding Message}" Width="3*" />
	</DataGrid.Columns>
  </DataGrid>
</UserControl>
