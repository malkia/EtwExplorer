<UserControl x:Class="EtwExplorer.Views.StringsTabView"
			 xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowDefinitions="Auto,*" Margin="8">
	<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
	  <TextBlock Text="Search:" VerticalAlignment="Center" />
	  <TextBox Width="300" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Watermark="Type to search" />
	</StackPanel>
	<DataGrid Grid.Row="1" ItemsSource="{Binding StringView}" AutoGenerateColumns="False" IsReadOnly="True">
	  <DataGrid.Columns>
		<DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
		<DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="3*" />
	  </DataGrid.Columns>
	</DataGrid>
  </Grid>
</UserControl>
