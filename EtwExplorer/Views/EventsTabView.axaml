<UserControl x:Class="EtwExplorer.Views.EventsTabView"
			 xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:view="using:EtwExplorer.Views">
  <Grid RowDefinitions="Auto,*" Margin="8">
	<view:SearchBox Margin="0,0,0,8" />
	<DataGrid Grid.Row="1" ItemsSource="{Binding EventView}" AutoGenerateColumns="False" IsReadOnly="True" RowDetailsVisibilityMode="VisibleWhenSelected">
	  <DataGrid.RowDetailsTemplate>
		<DataTemplate>
		  <DataGrid ItemsSource="{Binding EventDetails}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300" Margin="4">
			<DataGrid.Columns>
			  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
			  <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
			</DataGrid.Columns>
		  </DataGrid>
		</DataTemplate>
	  </DataGrid.RowDetailsTemplate>
	  <DataGrid.Columns>
		<DataGridTextColumn Header="Name" Binding="{Binding Event.Symbol}" Width="2*" />
		<DataGridTextColumn Header="Value" Binding="{Binding Event.Value}" Width="*" />
		<DataGridTextColumn Header="Version" Binding="{Binding Event.Version}" Width="*" />
		<DataGridTextColumn Header="Task" Binding="{Binding Event.Task}" Width="*" />
		<DataGridTextColumn Header="Keyword" Binding="{Binding Event.Keyword}" Width="*" />
		<DataGridTextColumn Header="Template" Binding="{Binding Event.Template}" Width="*" />
		<DataGridTextColumn Header="Opcode" Binding="{Binding Event.Opcode}" Width="*" />
		<DataGridTextColumn Header="Level" Binding="{Binding Event.Level}" Width="*" />
	  </DataGrid.Columns>
	</DataGrid>
  </Grid>
</UserControl>
